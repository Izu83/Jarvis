# Copy to .env. Nothing here is needed for the default Claude Code brain (it uses your Claude login).

# Only for "brain": "api" in config.json. Get a key at https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-...

# Created automatically by `run.bat --pair`
# JARVIS_TOPIC=
# JARVIS_KEY=

# Email (check / reply / send). Easiest: run.bat --email. Not your normal password: an app password.
# Gmail: turn on 2-Step Verification, then create one at https://myaccount.google.com/apppasswords
# EMAIL_APP_PASSWORD=abcd efgh ijkl mnop
